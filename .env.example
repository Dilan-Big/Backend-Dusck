# Copia este archivo a .env y completa los valores locales.
# NUNCA subas .env a Git. Este .env.example solo contiene placeholders.

# Cadena de conexion a MongoDB.
# Local:  mongodb://localhost:27017/db-dusck
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/db-dusck
MONGO_URI=

# Secreto para firmar/verificar JWT. Genera uno fuerte y unico, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Puerto del servidor HTTP.
PORT=3000

# Origen del frontend (Angular) permitido para CORS.
FRONTEND_URL=http://localhost:4200

# --- Solo desarrollo local: contrasenas de las cuentas de prueba que crea
#     `node scripts/seed.js`. Sin valores aqui. En tu .env puedes usar el mismo
#     valor en las cuatro. El seed NO se ejecuta al arrancar el backend.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_SUBSCRIBER_PASSWORD=

# --- FASE 4 — Cloudinary (imagenes de producto). OPCIONALES: si faltan, el
#     servidor arranca igual (no rompe el resto de fases) pero
#     POST/DELETE /api/product/:id/images responden un error controlado.
#     Consiguelas en https://console.cloudinary.com (plan gratuito alcanza).
#     CLOUDINARY_API_SECRET es un secreto real: NUNCA lo subas a Git, NUNCA lo
#     pongas en el frontend, NUNCA lo pegues en un mensaje/log/issue.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raiz de Cloudinary donde se organizan las imagenes (opcional).
CLOUDINARY_UPLOAD_FOLDER=dusck/products
